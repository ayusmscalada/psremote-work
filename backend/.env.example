# Supabase project URL and publishable key (Settings → API → Project API keys)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# For npm run db:migrate — use ONE of the following:
# A) Database password (Settings → Database → Database password)
SUPABASE_DB_PASSWORD=your-database-password
# B) Personal access token (https://supabase.com/dashboard/account/tokens)
# SUPABASE_ACCESS_TOKEN=your-access-token

# Optional: storage bucket for resume/screenshot uploads (must be public)
SUPABASE_STORAGE_BUCKET=application-files

JWT_SECRET=change-me-in-production
PORT=3001
